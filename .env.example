# Copie para .env (desenvolvimento local): cp .env.example .env
# Os valores abaixo batem com o docker-compose.yml. NUNCA use estes valores em produção.
# Na Vercel, configure cada variável separadamente em Production, Preview e Development.

# --- Banco de dados (PostgreSQL 16) ---
# Usada pelo app em runtime. Em produção: endereço COM pooling (pooler do Neon/Supabase).
DATABASE_URL="postgresql://fecharota:fecharota@localhost:5432/fecharota_dev"
# Usada só pela CLI do Prisma (migrations). Em produção: endereço DIRETO, sem pooler.
DIRECT_URL="postgresql://fecharota:fecharota@localhost:5432/fecharota_dev"

# --- Arquivos (API S3: RustFS local, Cloudflare R2 em produção) ---
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT="http://localhost:9000"
# R2: "auto"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="fecharota"
S3_SECRET_ACCESS_KEY="fecharota-secret"
# Um bucket por ambiente. Produção e preview NUNCA compartilham bucket.
S3_BUCKET="fecharota-dev"
# "true" para RustFS local. "false" para o R2.
S3_FORCE_PATH_STYLE="true"

# --- Rate limiting (Upstash Redis) ---
# Obrigatórias em qualquer deploy na Vercel (produção e preview).
# Na máquina local podem ficar vazias: o app usa um limitador em memória.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Somente máquina local: permite `pnpm build && pnpm start` (usado pelos testes E2E) sem
# Upstash. Definir como "true" dentro da Vercel faz o build falhar.
ALLOW_IN_MEMORY_RATE_LIMIT="true"

# --- Tarefas agendadas (Vercel Cron) ---
# Mínimo de 32 caracteres. Gere com: openssl rand -hex 32
CRON_SECRET="troque-este-valor-local-com-32-caracteres-ou-mais"

# --- Somente desenvolvimento ---
# Troca rápida de perfil. Só funciona com NODE_ENV=development. Definir como "true"
# em qualquer outro ambiente faz o app se recusar a iniciar.
ENABLE_DEV_IMPERSONATION="false"
