# Usado pelos testes E2E (Playwright). Banco e bucket PRÓPRIOS, recriados a cada execução:
# rodar o E2E não apaga os dados de desenvolvimento. Só credenciais locais descartáveis.
NODE_ENV="production"
DATABASE_URL="postgresql://fecharota:fecharota@localhost:5432/fecharota_e2e"
DIRECT_URL="postgresql://fecharota:fecharota@localhost:5432/fecharota_e2e"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="fecharota"
S3_SECRET_ACCESS_KEY="fecharota-secret"
S3_BUCKET="fecharota-e2e"
S3_FORCE_PATH_STYLE="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
ALLOW_IN_MEMORY_RATE_LIMIT="true"
CRON_SECRET="segredo-do-e2e-com-pelo-menos-32-caracteres"
ENABLE_DEV_IMPERSONATION="false"
