# Usado pelos testes de integração (Vitest). Aponta para os serviços de TESTE do docker-compose.yml.
# Contém apenas credenciais locais descartáveis, por isso fica versionado.
DATABASE_URL="postgresql://fecharota:fecharota@localhost:5433/fecharota_test"
DIRECT_URL="postgresql://fecharota:fecharota@localhost:5433/fecharota_test"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="fecharota"
S3_SECRET_ACCESS_KEY="fecharota-secret"
S3_BUCKET="fecharota-test"
S3_FORCE_PATH_STYLE="true"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
CRON_SECRET="segredo-de-teste-com-pelo-menos-32-caracteres"
ENABLE_DEV_IMPERSONATION="false"
